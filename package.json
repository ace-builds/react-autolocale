{
  "name": "react-autolocale",
  "version": "0.5.0",
  "description": "Wrap your React + Vite app in <AutoScale> and get fully translated static pages (/fr, /es, ...). Translations are generated by an explicit CLI step with a local model, OpenAI or Anthropic; builds never translate.",
  "license": "MIT",
  "keywords": [
    "react",
    "vite",
    "i18n",
    "translation",
    "localization",
    "l10n"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "react-autolocale": "dist/cli.js"
  },
  "oclif": {
    "bin": "react-autolocale",
    "dirname": "react-autolocale",
    "description": "Translate a React + Vite app into prerendered static pages for every language.",
    "topicSeparator": " ",
    "commands": {
      "strategy": "explicit",
      "target": "./dist/cli-commands.js",
      "identifier": "COMMANDS"
    },
    "helpOptions": {
      "hideAliasesFromRoot": true
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "prepublishOnly": "pnpm build && pnpm test",
    "e2e": "node e2e/run.mjs",
    "e2e:patterns": "node e2e/patterns.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@huggingface/transformers": ">=3",
    "react": ">=18",
    "vite": ">=5",
    "openai": ">=6",
    "@anthropic-ai/sdk": ">=0.60"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    },
    "openai": {
      "optional": true
    },
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "dependencies": {
    "@babel/generator": "^8.0.6",
    "@babel/parser": "^8.0.7",
    "@babel/traverse": "^8.0.7",
    "@babel/types": "^8.0.6",
    "@clack/prompts": "^1.8.1",
    "@oclif/core": "^4.14.0",
    "jsdom": "^30.1.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@huggingface/transformers": "^4.3.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "openai": "^7.32.0",
    "playwright-core": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
