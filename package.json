{
  "name": "react-autolocale",
  "version": "0.2.0",
  "description": "Wrap your React + Vite app in <AutoScale> and get fully translated static pages (/fr, /es, ...) from one build. Free local translation.",
  "license": "MIT",
  "keywords": [
    "react",
    "vite",
    "i18n",
    "translation",
    "localization",
    "l10n"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "react-autolocale": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "prepublishOnly": "pnpm build && pnpm test",
    "e2e": "node e2e/run.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": ">=18",
    "vite": ">=5",
    "@huggingface/transformers": ">=3"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "dependencies": {
    "@babel/generator": "^8.0.6",
    "@babel/parser": "^8.0.7",
    "@babel/traverse": "^8.0.7",
    "@babel/types": "^8.0.6",
    "jsdom": "^30.1.2"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "@huggingface/transformers": "^4.3.1",
    "playwright-core": "^1.50.0"
  }
}
